# ==============================================================================
# OpenDeal Environment Configuration Template (.env.example)
#
# Copy this file to .env to customize local configuration.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Application Environment ('development', 'testing', 'production')
OPENDEAL_ENVIRONMENT=production
OPENDEAL_DEBUG=false

# Data Directory and Storage
# Database path can be relative to cwd or an absolute path on local disk.
OPENDEAL_STORAGE__DATABASE_PATH=opendeal.db
OPENDEAL_STORAGE__ECHO_SQL=false

# SEC EDGAR Official Connector (Optional / Network-enabled)
# SEC EDGAR requires a User-Agent header in the format: "Sample Organization Name AdminContact@domain.com"
OPENDEAL_SEC__USER_AGENT="OpenDealPlatform research@opendeal-intelligence.org"
OPENDEAL_SEC__RATE_LIMIT_PER_SECOND=5.0
OPENDEAL_SEC__TIMEOUT_SECONDS=20.0
OPENDEAL_SEC__MAX_RETRIES=3

# UK Companies House Official Connector (Optional / Network-enabled)
# Obtain a free REST API key at https://developer.company-information.service.gov.uk/
# Leave blank to disable live Companies House queries or use offline mock mode.
OPENDEAL_COMPANIES_HOUSE__API_KEY=
OPENDEAL_COMPANIES_HOUSE__RATE_LIMIT_PER_SECOND=2.0
OPENDEAL_COMPANIES_HOUSE__TIMEOUT_SECONDS=15.0
OPENDEAL_COMPANIES_HOUSE__MAX_RETRIES=3

# Local UI Server Defaults
# The web server binds to loopback (127.0.0.1) by default.
OPENDEAL_UI_HOST=127.0.0.1
OPENDEAL_UI_PORT=8000
